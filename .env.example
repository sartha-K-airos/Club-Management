# Database — SQLite file path (relative to prisma/)
DATABASE_URL="file:./dev.db"

# JWT signing secret — change this in production!
JWT_SECRET="your-jwt-secret-here"

# HMAC secret for signing event passes — change in production!
PASS_SIGNING_SECRET="your-pass-signing-secret-here"

# Razorpay test-mode credentials (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"

# Server port
PORT=3000
