{
  "name": "club-and-society-management",
  "version": "2.0.0",
  "description": "MITS Club & Society Management — Full Stack",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npx prisma generate && npx prisma db push",
    "postinstall": "npx prisma generate",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:seed": "node src/seed.js",
    "db:reset": "npx prisma db push --force-reset && node src/seed.js",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/style.css --watch"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "razorpay": "^2.9.4",
    "qrcode": "^1.5.4",
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.19"
  }
}
